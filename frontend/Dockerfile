FROM node:22-alpine AS build
WORKDIR /app
ARG VITE_PROMPT_DEBUG=false
ARG VITE_LEGAL_OPERATOR_NAME=""
ARG VITE_LEGAL_OPERATOR_ADDRESS=""
ARG VITE_LEGAL_CONTACT_EMAIL=""
ARG VITE_LEGAL_HOSTING=""
ENV VITE_PROMPT_DEBUG=$VITE_PROMPT_DEBUG
ENV VITE_LEGAL_OPERATOR_NAME=$VITE_LEGAL_OPERATOR_NAME
ENV VITE_LEGAL_OPERATOR_ADDRESS=$VITE_LEGAL_OPERATOR_ADDRESS
ENV VITE_LEGAL_CONTACT_EMAIL=$VITE_LEGAL_CONTACT_EMAIL
ENV VITE_LEGAL_HOSTING=$VITE_LEGAL_HOSTING
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
